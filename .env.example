# Copy to .env and fill in. Loaded by src/cev_alignment/config.py with python-dotenv
# (https://pypi.org/project/python-dotenv/); real shell environment variables take precedence.

# OpenRouter API key (https://openrouter.ai/keys). Inspect's OpenRouter provider reads it
# (https://inspect.aisi.org.uk/providers.html#openrouter). Never commit the real value.
OPENROUTER_API_KEY=sk-or-...

# Models under test (comma-separated OpenRouter ids, without the "openrouter/" prefix).
# One cheap model each from GPT, Claude, Qwen and Llama 3.x (prices checked 2026-10-16).
MODELS=openai/gpt-6-luna,anthropic/claude-haiku-5.5,qwen/qwen3.6-35b-a3b,meta-llama/llama-3.3-70b-instruct

# Models whose "thinking" is switched off (Inspect model arg reasoning_enabled=False -> OpenRouter
# reasoning.enabled=false). In the first pilot Qwen3.6 often spent its whole token budget reasoning, sometimes
# returning an empty answer.
NO_REASONING_MODELS=qwen/qwen3.6-35b-a3b

# Judge / grader model for all LLM-graded evals (outside the four tested families).
JUDGE_MODEL=google/gemini-3.1-flash-lite

# System-prompt conditions to run (subset of: none,classic,cev,classic_cev,classic_lenmatch).
CONDITIONS=none,classic,cev,classic_cev,classic_lenmatch

# Evals to run (subset of: humanebench,human_agency,darkbench,ai_risk,instrumentaleval,agentic_misalignment).
EVALS=humanebench,human_agency,darkbench,ai_risk,instrumentaleval,agentic_misalignment

# Items per model x condition cell for each eval (scaled down automatically by the budget gate).
N_HUMANEBENCH=48
N_HUMAN_AGENCY=60
N_DARKBENCH=60
N_AI_RISK=90
N_INSTRUMENTALEVAL=60
EPOCHS_AGENTIC_MISALIGNMENT=15

# Items per eval per cell in the pilot run used to project cost (at least one per stratum, so stratified evals run
# more: e.g. 8 for HumaneBench's 8 principles).
PILOT_N=2

# Spending cap in USD: the pilot's token usage x OpenRouter list prices projects the full run, and n is scaled
# down if 90% of this cap minus the pilot cost would be exceeded.
MAX_BUDGET_USD=10

# Seed for item sampling (same items in every model x condition cell -> paired statistics).
SEED=42

# Target-model generation settings (Inspect GenerateConfig), sent to every model, including NO_REASONING_MODELS.
REASONING_EFFORT=low
MAX_TOKENS=4096

# Max concurrent connections per model (Inspect --max-connections). It is also part of the inspect_evals graders'
# config, so changing it stops eval_set from resuming those tasks (AGENTS.md).
MAX_CONNECTIONS=20

# Cap in USD on each paid judge check's estimated (upper-bound) cost (`--judge-checks`); a check over it stops before
# any call. Estimates for a full run: blinding ~0.7, validity ~0.15, settings ~1.2 (reports/spend.json), so 1.5 runs
# them all.
JUDGE_CHECKS_MAX_USD=1.5
